PORT=3000
DEFAULT_PROVIDER=balldontlie
# Use the existing odds gateway when a general league-data key is absent.
MOCK_WHEN_UNCONFIGURED=false
ALLOW_MOCK_DATA=false

# The Odds API
ODDS_API_KEY=replace_me
ODDS_API_BASE_URL=https://api.the-odds-api.com

# Provider selection overrides per league.
# Valid values: odds, balldontlie, moneyline, apisports, thesportsdb, sportsdataio, mock
PROVIDER_NBA=balldontlie
PROVIDER_NFL=balldontlie
PROVIDER_NCAAM=balldontlie
PROVIDER_NCAAF=balldontlie
PROVIDER_MLB=balldontlie
PROVIDER_NHL=balldontlie

# BALLDONTLIE
BALLDONTLIE_API_KEY=
BALLDONTLIE_BASE_URL=https://api.balldontlie.io

# MoneyLine (honors the existing Render variable name)
MONEY_LINE_API=
MONEYLINE_ENABLED=true
MONEYLINE_BASE_URL=https://mlapi.bet/v1

# TheSportsDB free v1 (shared public free key: 123)
THESPORTSDB_API_KEY=
THESPORTSDB_ENABLED=true
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json

# SportsDataIO
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_BASE_URL=https://api.sportsdata.io

# SharpAPI Free (key stays on the server)
SHARP_API_KEY=
SHARP_API_ENABLED=true
SHARP_API_BASE_URL=https://api.sharpapi.io
# General discovery and odds orders. BetMGM core boards use the preference below.
ODDS_PROVIDER_ORDER=sharpApi,oddsPapi,moneyline,sportsGameOdds,parlayApi,theOddsApi
ODDS_SPORTS_PROVIDER_ORDER=sharpApi,oddsPapi,parlayApi,theOddsApi,sportsGameOdds
# Only for automatic core boards explicitly requesting BetMGM. Does not enable
# providers, override diagnostic requests, or change provider-specific event IDs.
ODDS_BETMGM_PROVIDER_ORDER=parlayApi,oddsPapi,sportsGameOdds,theOddsApi

# OddsPapi direct key (query authentication stays server-side)
ODDSPAPI_ENABLED=true
ODDSPAPI_API_KEY=
# API-Sports direct dashboard key, not RapidAPI
API_SPORTS_ENABLED=true
API_SPORTS_API_KEY=
