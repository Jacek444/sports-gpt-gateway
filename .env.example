PORT=3000
DEFAULT_PROVIDER=balldontlie
MOCK_WHEN_UNCONFIGURED=true

# The Odds API
ODDS_API_KEY=replace_me
ODDS_API_BASE_URL=https://api.the-odds-api.com

# Provider selection overrides per league.
# Valid values: balldontlie, sportsdataio, mock
PROVIDER_NBA=balldontlie
PROVIDER_NFL=balldontlie
PROVIDER_NCAAM=balldontlie
PROVIDER_NCAAF=balldontlie
PROVIDER_MLB=balldontlie
PROVIDER_NHL=balldontlie

# BALLDONTLIE
BALLDONTLIE_API_KEY=replace_me
BALLDONTLIE_BASE_URL=https://api.balldontlie.io

# SportsDataIO
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_BASE_URL=https://api.sportsdata.io
